# 轻量级 PyPI 服务器镜像
# 仅包含 pypiserver，Python 包通过磁盘映射方式挂载
#
# 构建镜像:
#   docker build -f Dockerfile.pypiserver -t offline-pypi:latest .
#
# 运行容器:
#   docker run -d -p 8080:8080 -v ./packages:/opt/pypi/packages offline-pypi:latest
#

FROM python:3.10-slim

LABEL maintainer="offline-pypi"
LABEL description="轻量级 PyPI 服务器，用于离线环境的 Python 包分发"

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 配置 pip 使用阿里云镜像源以加速下载
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set install.trusted-host mirrors.aliyun.com

# 安装 pypiserver
# pypiserver 是一个轻量级的 PyPI 兼容服务器
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir pypiserver

# 创建包存储目录（将被外部卷覆盖）
RUN mkdir -p /opt/pypi/packages

# 创建非 root 用户运行服务
RUN groupadd -r pypi && useradd -r -g pypi pypi && \
    chown -R pypi:pypi /opt/pypi

# 暴露端口
EXPOSE 8080

# 切换到非 root 用户
USER pypi

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/')" || exit 1

# 设置容器启动命令
# -p 8080: 监听端口
# -a .: 允许所有动作 (download, list)
# -P .: 无密码认证 (适用于内网环境)
# /opt/pypi/packages: 包存储目录
CMD ["pypi-server", "run", "-p", "8080", "-a", ".", "-P", ".", "/opt/pypi/packages"]
